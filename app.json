{
  "expo": {
    "name": "OdontoApp",
    "slug": "OdontoApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
   "ios": {
  "supportsTablet": true,
  "config": {
    "usesNonExemptEncryption": false
  },
  "bundleIdentifier": "com.angel0107.OdontoApp",
  "infoPlist": {
    "NSFaceIDUsageDescription": "OdontoApp requiere Face ID para permitirte ingresar rápidamente sin ingresar tu contraseña."
  }
},
    "android": {
      "package": "com.angel0107.OdontoApp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "OdontoApp necesita acceso a tus fotos para adjuntar radiografías e imágenes al expediente del paciente.",
          "cameraPermission": "OdontoApp necesita acceso a la cámara para tomar fotos intraorales y radiografías."
        }
        
      ],
      [
    "expo-local-authentication",
    {
      "faceIDPermission": "OdontoApp requiere Face ID para permitirte ingresar rápidamente sin ingresar tu contraseña."
    }
  ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8198b8ab-4652-4602-bef6-3f6471cd35f6"
      }
    }
  }
}